{
  "name": "autograde-plus-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AutoGrade+ Monorepo - AI-Powered Automated Grading System",
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "backend:dev": "cd backend && venv/bin/uvicorn app.main:app --reload --port 8000",
    "build": "cd frontend && npm run build",
    "lint": "cd frontend && npm run lint",
    "preview": "cd frontend && npm run preview",
    "generate-mock": "python3 ai-pipeline/generate_mock_data.py",
    "evaluate": "python3 evaluation/evaluate_prompts.py",
    "reset-db": "PYTHONPATH=backend backend/venv/bin/python backend/reset_db.py"
  }
}
