# Database Configuration (PostgreSQL primary with local SQLite fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autograde

# AWS S3 Storage Configuration (Optional - falls back to local uploads/ if not set)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=autograde-submissions

# LLM API Configuration (OpenRouter / Gemini)
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=google/gemini-2.5-flash

# Application Configuration
PROMPT_VERSION=v1.2-rubric-cot
