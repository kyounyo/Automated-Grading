# AutoGrade+ Docker configuration
# Copy this file to `.env` (same folder as docker-compose.yml) and fill in your key.

# Required: your OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AI models used for grading and auditing
LLM_MODEL=google/gemini-3.1-flash-lite
AUDITOR_MODEL=google/gemini-3.1-flash-lite
PROMPT_VERSION=v1.2-rubric-cot

# Port the app opens on: http://localhost:8080
APP_PORT=8080

# Optional grading settings
# CONFIDENCE_THRESHOLD=0.75
# ENABLE_RANDOM_QC_AUDIT=false
# QC_AUDIT_RATE=0.05

# Optional: store uploads in AWS S3 instead of the local Docker volume
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=
